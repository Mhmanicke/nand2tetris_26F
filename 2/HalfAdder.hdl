// File name: projects/2/HalfAdder.hdl
/**
 * Computes the sum of two bits.
 */
CHIP HalfAdder {
    IN a, b;    // 1-bit inputs
    OUT sum,    // Right bit of a + b 
        carry;  // Left bit of a + b

//The XOR determines the sum because it outputs 1 when exactly 
//one input is 1. The AND determines the carry because a carry 
//only happens when both inputs are 1.
    PARTS:
    // XOR gives the sum, AND gives the carry 
    Xor(a=a, b=b, out=sum);
    And(a=a, b=b, out=carry);
}
