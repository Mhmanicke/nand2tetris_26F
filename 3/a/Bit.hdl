// File name: projects/3/a/Bit.hdl
/**
 * 1-bit register:
 * If load is asserted, the register's value is set to in;
 * Otherwise, the register maintains its current value:
 * if (load(t)) out(t+1) = in(t), else out(t+1) = out(t)
 */
CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    // IN = What value do i want to store?
    // load = Do i want to store it?
    // If load = 1, store the new input.
    // If load = 0, keep the old value.
    Mux(a=oldOut, b=in, sel=load, out=muxOut);

    // DFF stores the selected bit.
    DFF(in=muxOut, out=oldOut, out=out);
}
