// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

// Routes one input to 1 of four outputs: a, b, c, or d.
// sel[1] first chooses which half: a/b or c/d.
// sel[0] then chooses the exact output inside that half.
// sel=00->a, 01->b, 10->c, 11->d.
    PARTS:
    DMux(in=in, sel=sel[1], a=low, b=high);

    DMux(in=low, sel=sel[0], a=a, b=b);
    DMux(in=high, sel=sel[0], a=c, b=d);
}