// File name: projects/1/Mux8Way16.hdl
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

// Chooses 1 of eight 16-bit inputs (a through h).
// sel[0..1] chooses one input from each group of four.
// This gives one result from a-d and one result from e-h.
// sel[2] then chooses which group's result becomes the final output.
    PARTS:
    Mux4Way16(
        a=a, b=b, c=c, d=d,
        sel=sel[0..1],
        out=abcd
    );

    Mux4Way16(
        a=e, b=f, c=g, d=h,
        sel=sel[0..1],
        out=efgh
    );

    Mux16(
        a=abcd,
        b=efgh,
        sel=sel[2],
        out=out
    );
}
