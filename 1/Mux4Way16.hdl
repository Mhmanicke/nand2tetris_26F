// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
// Chooses 1 of four 16-bit inputs: a, b, c, or d.
// sel[0] first chooses within the pairs (a/b and c/d).
// sel[1] then chooses which pair's result becomes the output.
// sel=00->a, 01->b, 10->c, 11->d.
    PARTS:
    Mux16(a=a, b=b, sel=sel[0], out=ab);
    Mux16(a=c, b=d, sel=sel[0], out=cd);

    Mux16(a=ab, b=cd, sel=sel[1], out=out);
}