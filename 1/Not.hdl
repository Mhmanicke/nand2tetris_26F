// File name: projects/1/Not.hdl
/**
 * Not gate:
 * if (in) out = 0, else out = 1
 */
CHIP Not {
    IN in;
    OUT out;

// NOT flips the input: 0->1 and 1->0.
// Using the same input for both NAND inputs makes NAND act like NOT.
    PARTS:
    Nand(a=in, b=in, out=out);
}
