// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

// Routes one input to 1 of eight outputs (a through h).
// sel[2] first chooses which group of four should receive the input.
// sel[0..1] then chooses the exact output within that group.
// 000->a, 001->b, 010->c, 011->d,
// 100->e, 101->f, 110->g, 111->h.
    PARTS:
    DMux(in=in, sel=sel[2], a=low, b=high);

    DMux4Way(
        in=low,
        sel=sel[0..1],
        a=a,
        b=b,
        c=c,
        d=d
    );

    DMux4Way(
        in=high,
        sel=sel[0..1],
        a=e,
        b=f,
        c=g,
        d=h
    );
}
